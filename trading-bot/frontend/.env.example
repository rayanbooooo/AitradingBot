# Only needed when the frontend is hosted separately from the backend
# (e.g. this app on Vercel, backend on a VPS/Railway/Fly.io). Leave unset
# for local dev -- the Vite proxy in vite.config.js handles it.

# Backend REST API base URL, e.g. https://your-backend.example.com/api
VITE_API_BASE=

# Backend WebSocket URL, e.g. wss://your-backend.example.com/ws
# Must be wss:// (not ws://) if the frontend is served over https -- browsers
# block a secure page from opening an insecure websocket.
VITE_WS_URL=
