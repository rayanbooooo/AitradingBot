# ============================================================================
# Copy this file to .env and fill in your own values. Never commit .env.
# ============================================================================

# --- Binance API credentials ---
# Get these from https://www.binance.com/en/my/settings/api-management
# Restrict the key to "Enable Spot Trading" only. Do NOT enable withdrawals.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Use Binance's spot testnet (https://testnet.binance.vision) for safe dry runs
# with fake funds before ever pointing this at your real account.
# true  = testnet (fake money, real market data)
# false = real Binance account, real money
USE_TESTNET=true

# --- LIVE TRADING GATE ------------------------------------------------------
# This is the ONLY switch that turns on real order placement. It is read once
# at process startup, not exposed as a dashboard toggle, and requires a full
# backend restart to change, exactly as required by the mandatory safety spec.
# false = signals are generated and logged, but NO orders are ever sent.
# true  = the bot will place real orders (still subject to every risk-manager
#         rule and to the manual-approval toggle, which IS controllable live
#         from the dashboard).
LIVE_TRADING_ENABLED=false

# --- Account / risk configuration ---
# The account balance the position-sizing formula uses. For a real account
# this is fetched live from Binance; this value is only used as a fallback
# and as the basis for testnet simulations.
STARTING_ACCOUNT_BALANCE_USDT=10000

# Execution uses USDS-M Futures (not Spot) because Spot cannot open SHORT
# positions. Leverage is pinned low on purpose -- see backend/src/config.js.
FUTURES_LEVERAGE=1

RISK_PER_TRADE_PERCENT=2
MAX_CONCURRENT_POSITIONS=3
DAILY_LOSS_LIMIT_PERCENT=5
WEEKLY_LOSS_LIMIT_PERCENT=10
CONSECUTIVE_LOSS_COOLDOWN_COUNT=3
CONSECUTIVE_LOSS_COOLDOWN_MINUTES=60
MIN_RISK_REWARD_RATIO=2
MIN_SIGNAL_SCORE=65
POSITION_TIME_DECAY_HOURS=24

# --- Manual approval default (can be flipped live from the dashboard) ---
# true  = every signal sits in an approval queue until you click "execute".
# false = signals that pass risk checks execute automatically within ~2s.
MANUAL_APPROVAL_DEFAULT=true

# --- Server ---
PORT=4000
WS_PORT=4001

# --- Optional: inbound TradingView Pine Script alert webhook ---
# Set a long random secret. TradingView alert JSON must include this in a
# "secret" field, or the webhook is rejected.
TRADINGVIEW_WEBHOOK_SECRET=change-me-to-a-long-random-string
